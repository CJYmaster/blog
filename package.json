{
  "name": "moss-notes",
  "version": "1.0.0",
  "private": true,
  "description": "一个零依赖的极简个人博客：Markdown 写作 + 自己写的构建脚本",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node serve.mjs",
